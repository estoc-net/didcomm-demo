// Static-assets Worker: `npm run deploy` builds dist/ and ships it to
// https://didcomm-demo.estoc.dev (custom domain on the estoc.dev zone,
// same account as the mediator Worker).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "didcomm-demo",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "didcomm-demo.estoc.dev",
      "custom_domain": true
    }
  ]
}
